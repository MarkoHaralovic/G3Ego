{
  "experiment_name": "egtea_gaze_full_graph_lstm_30ep",
  "mlp": {
    "fc_layers_num": 2,
    "num_graphs": 10,
    "use_pool": true,
    "use_proj": true,
    "action_graph_embedder": {
      "clip_text_emb_out_feats": 64,
      "emb_dim": 128,
      "obj_out": 128,
      "aux_out": 128,
      "attr_out": 128,
      "rel_out": 128,
      "trip_out": 128,
      "k_obj": 2,
      "k_aux": 2,
      "k_trip": 2,
      "clip_dim": 1024,
      "clip_emb_dim": 512,
      "obj_feat_dim": 256,
      "use_triplets": true,
      "use_clip_text_emb": false
    },
    "projector": {
      "graph_emb_dim": 512,
      "layer_norm": true,
      "gelu": true
    },
    "attention_pooler": {
      "graph_pool_interim_feat": 128,
      "final_graph_emb_dim": 256
    },
    "head": {
      "dropout": 0.3,
      "activation": "gelu"
    }
  },
  "lstm": {
    "hidden_size": 128,
    "num_layers": 2,
    "bias": true,
    "bidirectional": true,
    "recurrent_dropout": 0.2,
    "readout": "last_hidden"
  },
  "data": {
    "input_path": "/path/to/ego_graphs/vlm_datasets/egtea_gaze/vlm_ann_Qwen3-VL-32B-Instruct",
    "feature_root": "/path/to/ego_graphs/vlm_datasets/egtea_gaze/framewise_videos/frame_cache_fps_30",
    "annotations_root": "/path/to/ego_graphs/vlm_datasets/egtea_gaze/annotations",
    "split_ids": [
      2,
      3
    ],
    "val_fraction": 0.1,
    "rgb_feature_filename": "frame_features_model_dinov3_vitl16.h5",
    "easg_cache_path": "/path/to/egocentric_video_graph_framework_ar/outputs/egtea_gaze/action_recognition/easg_tensor_cache_lstm_full_30ep",
    "batch_size": 64,
    "num_workers": 8,
    "pin_memory": true,
    "graph_type": "full",
    "val_distribution_source": "test"
  },
  "training": {
    "num_epochs": 30,
    "optimizer": "adam",
    "learning_rate": 0.0003,
    "weight_decay": 1e-05,
    "scheduler_factor": 0.95,
    "criterion_metrics": [
      "f1",
      "acc"
    ],
    "final_checkpoint_metric": "mean_accuracy",
    "loss": {
      "name": "cross_entropy",
      "ifw": true,
      "focal_gamma": 2.0
    }
  },
  "output": {
    "base_path": "/path/to/egocentric_video_graph_framework_ar/outputs/egtea_gaze/action_recognition/lstm_graph_construction_ablation"
  },
  "device": "cuda"
}
