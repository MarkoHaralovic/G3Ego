{
  "experiment_name": "egtea_gaze_pruned_graph_mlp_baseline",
  "mlp": {
    "fc_layers_num": 2,
    "num_graphs": 10,
    "use_pool": true,
    "use_proj": true,
    "action_graph_embedder": {
      "clip_text_emb_out_feats": 64,
      "emb_dim": 32,
      "obj_out": 32,
      "aux_out": 0,
      "attr_out": 32,
      "rel_out": 32,
      "trip_out": 32,
      "k_obj": 2,
      "k_aux": 0,
      "k_trip": 2,
      "clip_dim": 1024,
      "clip_emb_dim": 512,
      "obj_feat_dim": 256,
      "use_triplets": true,
      "use_clip_text_emb": false
    },
    "projector": {
      "graph_emb_dim": 256,
      "layer_norm": true,
      "gelu": true
    },
    "attention_pooler": {
      "graph_pool_interim_feat": 128,
      "final_graph_emb_dim": 64
    }
  },
  "data": {
    "input_path": "/path/to/ego_graphs/vlm_datasets/egtea_gaze/vlm_ann_Qwen3-VL-32B-Instruct",
    "feature_root": "/path/to/ego_graphs/vlm_datasets/egtea_gaze/framewise_videos/frame_cache_fps_30",
    "annotations_root": "/path/to/ego_graphs/vlm_datasets/egtea_gaze/annotations",
    "split_id": 1,
    "val_fraction": 0.1,
    "rgb_feature_filename": "frame_features_model_dinov3_vitl16.h5",
    "easg_cache_path": "/path/to/egocentric_video_graph_framework_ar/outputs/egtea_gaze/action_recognition/easg_tensor_cache",
    "batch_size": 16,
    "num_workers": 2,
    "pin_memory": true,
    "graph_type": "pruned",
    "val_distribution_source": "test"
  },
  "training": {
    "num_epochs": 8,
    "optimizer": "adam",
    "learning_rate": 0.0005,
    "weight_decay": 1e-05,
    "scheduler_factor": 0.95,
    "criterion_metrics": [
      "f1",
      "acc"
    ],
    "loss": {
      "name": "cross_entropy",
      "ifw": true,
      "focal_gamma": 2.0
    }
  },
  "output": {
    "base_path": "/path/to/egocentric_video_graph_framework_ar/outputs/egtea_gaze/action_recognition"
  },
  "device": "cuda"
}
