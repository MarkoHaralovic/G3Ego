{
  "study": {
    "study_name": "meccano_ar_lstm_full_hpo",
    "direction": "maximize",
    "storage": "sqlite:////path/to/egocentric_video_graph_framework_ar/outputs/meccano/action_recognition/optuna/meccano_ar_lstm_full_hpo.db",
    "load_if_exists": true,
    "n_trials": 50,
    "sampler": {
      "name": "TPESampler",
      "seed": 44
    },
    "pruner": {
      "name": "MedianPruner",
      "n_startup_trials": 5,
      "n_warmup_steps": 3
    }
  },
  "objective": {
    "metric": "top5",
    "run_test": false
  },
  "fixed_overrides": [
    {
      "path": "training.num_epochs",
      "value": 6
    }
  ],
  "search_space": [
    {"name": "learning_rate", "path": "training.learning_rate", "type": "float", "low": 1e-05, "high": 0.001, "log": true},
    {"name": "weight_decay", "path": "training.weight_decay", "type": "float", "low": 1e-06, "high": 0.001, "log": true},
    {"name": "scheduler_factor", "path": "training.scheduler_factor", "type": "float", "low": 0.9, "high": 0.99, "step": 0.01},
    {"name": "batch_size", "path": "data.batch_size", "type": "categorical", "choices": [8, 16]},
    {"name": "fc_layers_num", "path": "mlp.fc_layers_num", "type": "categorical", "choices": [1, 2, 3]},
    {"name": "graph_emb_dim", "path": "mlp.projector.graph_emb_dim", "type": "categorical", "choices": [128, 256, 384, 512]},
    {"name": "final_graph_emb_dim", "path": "mlp.attention_pooler.final_graph_emb_dim", "type": "categorical", "choices": [64, 128, 192, 256]},
    {"name": "lstm_hidden_size", "path": "lstm.hidden_size", "type": "categorical", "choices": [64, 128, 192, 256]},
    {"name": "lstm_num_layers", "path": "lstm.num_layers", "type": "categorical", "choices": [1, 2, 3]},
    {"name": "lstm_bidirectional", "path": "lstm.bidirectional", "type": "categorical", "choices": [false, true]},
    {"name": "recurrent_dropout", "path": "lstm.recurrent_dropout", "type": "float", "low": 0.0, "high": 0.5, "step": 0.1},
    {"name": "temporal_readout", "path": "lstm.readout", "type": "categorical", "choices": ["last_hidden", "attention"]},
    {"name": "head_dropout", "path": "mlp.head.dropout", "type": "float", "low": 0.0, "high": 0.6, "step": 0.1},
    {"name": "head_activation", "path": "mlp.head.activation", "type": "categorical", "choices": ["gelu", "relu"]},
    {"name": "loss_name", "path": "training.loss.name", "type": "categorical", "choices": ["cross_entropy", "focal_loss"]},
    {"name": "ifw", "path": "training.loss.ifw", "type": "categorical", "choices": [false, true]},
    {"name": "focal_gamma", "path": "training.loss.focal_gamma", "type": "float", "low": 1.0, "high": 3.0, "step": 0.5},
    {"name": "sampler_name", "path": "training.sampler.name", "type": "categorical", "choices": ["none", "balanced"]},
    {"name": "sampler_power", "path": "training.sampler.power", "type": "categorical", "choices": [0.5, 0.75, 1.0]}
  ]
}
